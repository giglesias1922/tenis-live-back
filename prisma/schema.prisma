// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}



enum SetStatus {
  ACTIVE
  CLOSED

  @@schema("public")
}



enum MatchStatus {
  ACTIVE
  CLOSED
  SUSPENDED

  @@schema("public")
}

model EventGroup {
  id  Int @id @default(autoincrement())
  description        String 

  eventType EventType[]

  @@schema("public")
  @@map("event_groups")
}

model EventType {
  id  Int @id @default(autoincrement())
  code String @unique
  description String
  createdAt DateTime  @default(now())
  active    Boolean @default(true)
  events      MatchEvent[]
  buttonText  String?
  buttonOrder Int?
  buttonColour  String?
  eventGroupId Int?
  pointWon Boolean @default(false)


  @@schema("public")
  @@map("event_types")
  eventGroup         EventGroup?      @relation(fields: [eventGroupId], references: [id])
}


model Club {
  id        Int       @id @default(autoincrement())
  name      String
  city      String?
  createdAt DateTime  @default(now())

  matches   Match[]

  @@schema("public")

  @@map("clubs")
}

model Match {
  id          Int     @id @default(autoincrement())
  clubId       Int
  opponentName String
  round        String?
  startTime    DateTime  @default(now())
  endTime      DateTime?
  won          Boolean?
  notes        String?
  supertiebreak          Boolean @default(false)
  status      MatchStatus?  @default(ACTIVE)

  club         Club      @relation(fields: [clubId], references: [id])
  sets         Set[]
  events        MatchEvent[]

  @@schema("public")

  @@map("matches")
}

model Set {
  id            Int   @id @default(autoincrement())
  matchId       Int
  setNumber     Int // 1, 2, 3
  playerGames   Int?
  opponentGames Int?
  status        SetStatus @default(ACTIVE)
  won           Boolean?
  match         Match @relation(fields: [matchId], references: [id])
  events        MatchEvent[]

  @@schema("public")

  @@map("sets")
}

model MatchEvent {
  id          Int      @id @default(autoincrement())
  matchId     Int
  setId       Int
  eventTypeId Int

  createdAt   DateTime @default(now())

  match       Match     @relation(fields: [matchId], references: [id])
  set         Set       @relation(fields: [setId], references: [id])
  eventType   EventType @relation(fields: [eventTypeId], references: [id])

  @@index([matchId])
  @@index([setId])
  @@index([eventTypeId])

  @@map("match_events")
  @@schema("public")
}
